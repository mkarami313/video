<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:icon="@drawable/ic_library"
            android:text="@string/pick_video" />

        <TextView
            android:id="@+id/txtFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="10dp"
            android:text="@string/no_file" />

        <!-- Format -->
        <TextView style="@style/SectionLabel" android:text="@string/format_label" />
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipFormat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">
            <com.google.android.material.chip.Chip android:id="@+id/fmtMp3" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="MP3" />
            <com.google.android.material.chip.Chip android:id="@+id/fmtM4a" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="M4A (AAC)" />
            <com.google.android.material.chip.Chip android:id="@+id/fmtWav" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="WAV" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Bitrate -->
        <LinearLayout android:id="@+id/bitrateBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView style="@style/SectionLabel" android:text="@string/quality_label" />
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipBitrate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">
                <com.google.android.material.chip.Chip android:id="@+id/br128" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="128k" />
                <com.google.android.material.chip.Chip android:id="@+id/br192" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="192k" />
                <com.google.android.material.chip.Chip android:id="@+id/br256" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="256k" />
                <com.google.android.material.chip.Chip android:id="@+id/br320" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="320k" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <!-- Channels -->
        <TextView style="@style/SectionLabel" android:text="@string/channels_label" />
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipChannels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">
            <com.google.android.material.chip.Chip android:id="@+id/chKeep" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="@string/keep_source" />
            <com.google.android.material.chip.Chip android:id="@+id/chMono" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/mono" />
            <com.google.android.material.chip.Chip android:id="@+id/chStereo" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stereo" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Advanced (trim / sample rate / gain / fade / tags) -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchAdvanced"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/advanced" />

        <LinearLayout
            android:id="@+id/advancedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Sample rate -->
            <TextView style="@style/SectionLabel" android:text="@string/samplerate_label" />
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipRate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">
                <com.google.android.material.chip.Chip android:id="@+id/rateKeep" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="@string/keep_source" />
                <com.google.android.material.chip.Chip android:id="@+id/rate44" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="44.1k" />
                <com.google.android.material.chip.Chip android:id="@+id/rate22" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="22.05k" />
                <com.google.android.material.chip.Chip android:id="@+id/rate16" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="16k" />
            </com.google.android.material.chip.ChipGroup>

            <!-- Trim -->
            <TextView style="@style/SectionLabel" android:text="@string/trim_label" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:hint="@string/trim_start" style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/editTrimStart" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:hint="@string/trim_end" style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/editTrimEnd" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Gain -->
            <TextView style="@style/SectionLabel" android:text="@string/gain_label" />
            <com.google.android.material.slider.Slider
                android:id="@+id/sliderGain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="0.2"
                android:valueTo="3.0"
                android:stepSize="0.1"
                android:value="1.0" />
            <TextView android:id="@+id/txtGain" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1.0×" />

            <!-- Fade -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:hint="@string/fade_in" style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/editFadeIn" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:hint="@string/fade_out" style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/editFadeOut" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Tags -->
            <TextView style="@style/SectionLabel" android:text="@string/tags_label" />
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/tag_title" style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/editTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:hint="@string/tag_artist" style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/editArtist" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:hint="@string/tag_album" style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/editAlbum" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCover"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pick_cover" />
                <ImageView
                    android:id="@+id/imgCover"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConvert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            app:icon="@drawable/ic_convert"
            android:text="@string/convert" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddQueue"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:enabled="false"
            app:icon="@drawable/ic_queue"
            android:text="@string/add_to_queue" />

    </LinearLayout>
</ScrollView>
